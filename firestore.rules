rules_version = '2';
// 🐚 Règles de sécurité Firestore
// ⚠️ Remplace l'email ci-dessous si le capitaine n'est pas penot.dev@gmail.com
//
// Qui voit quoi :
// - predictions : son auteur et le capitaine ; tout le monde après la naissance
// - answers     : version anonyme, visible seulement après avoir joué
// - messages    : les mots doux, visibles par leur auteur et le capitaine uniquement
service cloud.firestore {
  match /databases/{database}/documents {

    function isCaptain() {
      return request.auth != null
        && request.auth.token.email == "penot.dev@gmail.com";
    }
    function signedIn() {
      return request.auth != null;
    }
    function statePath() {
      return /databases/$(database)/documents/meta/state;
    }
    function isBorn() {
      return exists(statePath()) && get(statePath()).data.get('born', false) == true;
    }
    function hasVoted() {
      return signedIn() && exists(/databases/$(database)/documents/voters/$(request.auth.uid));
    }
    // Votes ouverts : pas fermés à la main, pas encore né, date limite pas dépassée
    function votingOpen() {
      return !exists(statePath()) || (
        get(statePath()).data.get('open', true) == true
        && get(statePath()).data.get('born', false) == false
        && (get(statePath()).data.get('deadline', 0) == 0
            || request.time.toMillis() < get(statePath()).data.get('deadline', 0))
      );
    }
    function str(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }
    function validAnswers(d) {
      return str(d.avatar, 1, 16)
        && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.time.matches('^[0-9]{2}:[0-9]{2}$')
        && d.weight is number && d.weight >= 1000 && d.weight <= 6000
        && d.height is number && d.height >= 30 && d.height <= 65
        && str(d.hair, 1, 20)
        && str(d.looks, 1, 20)
        && str(d.papaWhere, 1, 20)
        && str(d.mamanWhere, 1, 20)
        && str(d.babyName, 0, 30)
        && d.createdAt is number;
    }

    match /predictions/{id} {
      allow read: if isCaptain() || isBorn() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && votingOpen()
        && request.resource.data.keys().hasOnly(
             ['uid','name','avatar','date','time','weight','height','hair','looks','papaWhere','mamanWhere','babyName','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && str(request.resource.data.name, 1, 40)
        && validAnswers(request.resource.data);
      allow update, delete: if isCaptain();
    }

    match /answers/{id} {
      allow read: if isCaptain() || isBorn() || hasVoted();
      allow create: if signedIn() && votingOpen()
        && request.resource.data.keys().hasOnly(
             ['avatar','date','time','weight','height','hair','looks','papaWhere','mamanWhere','babyName','createdAt'])
        && validAnswers(request.resource.data)
        && getAfter(/databases/$(database)/documents/predictions/$(id)).data.uid == request.auth.uid;
      allow update, delete: if isCaptain();
    }

    match /messages/{id} {
      allow read: if isCaptain() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && votingOpen()
        && request.resource.data.keys().hasOnly(['uid','name','avatar','text','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && str(request.resource.data.text, 1, 280)
        && getAfter(/databases/$(database)/documents/predictions/$(id)).data.uid == request.auth.uid;
      allow update, delete: if isCaptain();
    }

    // « Cet appareil a joué » : sert à débloquer les stats anonymes et au compteur
    match /voters/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['predictionId'])
        && getAfter(/databases/$(database)/documents/predictions/$(request.resource.data.predictionId)).data.uid == uid;
      allow delete: if isCaptain();
    }

    // L'état du jeu (ouvert/fermé, date limite, résultats) : lecture publique, écriture capitaine
    match /meta/{doc} {
      allow read: if true;
      allow write: if isCaptain();
    }
  }
}
